rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'nyaaysahayogi@gmail.com')
      );
    }

    function isTenantAdmin(tenantId) {
      return isSuperAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/tenants/$(tenantId)/advocates/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)/advocates/$(request.auth.uid)).data.role in ['bar_admin', 'state_bar_admin']
      );
    }

    // Entity Validation Blueprints
    function isValidTenant(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 256 &&
             data.district is string && data.district.size() <= 128 &&
             data.plan in ['TRIAL', 'STARTER', 'PROFESSIONAL', 'ENTERPRISE_BAR'] &&
             data.status in ['ACTIVE', 'EXPIRED', 'SUSPENDED'] &&
             data.licenseKey is string && data.licenseKey.size() <= 64;
    }

    function isValidAdvocate(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.tenantId is string && data.tenantId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['super_admin', 'state_bar_admin', 'bar_admin', 'advocate', 'junior_advocate'] &&
             data.status in ['APPROVED', 'PENDING', 'REJECTED', 'SUSPENDED'];
    }

    function isValidClient(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.tenantId is string && data.tenantId.size() <= 128 &&
             data.advocateId is string && data.advocateId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128;
    }

    function isValidVote(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.electionId is string && data.electionId.size() <= 128 &&
             data.tenantId is string && data.tenantId.size() <= 128 &&
             data.voterIdHash is string && data.voterIdHash.size() <= 128 &&
             data.postId is string && data.postId.size() <= 128 &&
             data.candidateId is string && data.candidateId.size() <= 128;
    }

    function isValidELibraryItem(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
             data.category is string && data.category.size() <= 64;
    }

    function isValidBroadcast(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
             data.message is string && data.message.size() <= 4096;
    }

    // 1. Tenants Collection (Bar Associations)
    match /tenants/{tenantId} {
      allow get: if isValidId(tenantId);
      allow list: if true;
      allow create, update: if isSuperAdmin() && isValidId(tenantId) && isValidTenant(incoming());
      allow delete: if isSuperAdmin() && isValidId(tenantId);

      // Advocates Subcollection
      match /advocates/{advocateId} {
        allow get: if isValidId(advocateId);
        allow list: if true;
        allow create, update: if isValidId(advocateId) && isValidAdvocate(incoming());
        allow delete: if isTenantAdmin(tenantId) && isValidId(advocateId);
      }

      // Litigant Clients Subcollection
      match /clients/{clientId} {
        allow get: if isValidId(clientId);
        allow list: if true;
        allow create, update: if isValidId(clientId) && isValidClient(incoming());
        allow delete: if isValidId(clientId);
      }

      // Elections Subcollection
      match /elections/{electionId} {
        allow get, list: if true;
        allow create, update, delete: if isTenantAdmin(tenantId) && isValidId(electionId);

        // Votes Subcollection (Write-Once Secret Ballot)
        match /votes/{voteId} {
          allow get, list: if isTenantAdmin(tenantId);
          allow create: if isValidId(voteId) && isValidVote(incoming());
          allow update: if false; // Immutable ballots
          allow delete: if isSuperAdmin();
        }
      }
    }

    // 2. Global E-Library Collection
    match /elibrary/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin() && isValidId(itemId) && isValidELibraryItem(incoming());
    }

    // 3. Platform Settings
    match /platform_settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin() && isValidId(settingId);
    }

    // 4. Realtime Sync & Broadcast Collections (Bar & Advocate Realtime Engine)
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isValidId(broadcastId) && isValidBroadcast(incoming());
    }

    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isValidId(noticeId);
    }

    match /causelist/{causeId} {
      allow read: if true;
      allow write: if isValidId(causeId);
    }

    match /emergency/{emergencyId} {
      allow read: if true;
      allow write: if isValidId(emergencyId);
    }

    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Default Fallback: Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
