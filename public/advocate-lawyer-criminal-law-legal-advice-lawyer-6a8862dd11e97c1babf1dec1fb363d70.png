  <!-- Concentric White Inner Ring -->
  <circle cx="256" cy="256" r="236" fill="none" stroke="#FFFFFF" stroke-width="12" />

  <!-- Advocate Collar / Bowtie -->
  <path d="M 256 142 
           L 164 92 
           L 138 202 
           L 208 170 
           L 256 170 
           L 304 170 
           L 374 202 
           L 348 92 
           Z" 
        fill="#FFFFFF" />

  <!-- Left Band -->
